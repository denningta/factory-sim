{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(npx prettier *)",
      "Bash(npx playwright *)",
      "Bash(npx drizzle-kit *)",
      "Bash(node *)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(docker logs *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git rebase origin/main)",
      "Bash(git rebase --continue)",
      "Bash(git rebase --abort)",
      "Bash(git stash*)",
      "Bash(git restore *)",
      "Bash(git push -u origin story/*)",
      "Bash(git push origin story/*)",
      "Bash(git worktree list*)",
      "Bash(gh issue *)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr list*)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr checkout *)",
      "Bash(gh run *)",
      "Bash(gh label *)",
      "Bash(herdr agent *)",
      "Bash(herdr pane *)",
      "Bash(herdr tab *)",
      "Bash(herdr workspace list*)",
      "Bash(herdr worktree *)",
      "Bash(./scripts/team-up.sh *)",
      "Bash(scripts/team-up.sh *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push * main)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)",
      "Bash(gh api * -X DELETE*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf ..*)",
      "Bash(sudo *)",
      "Bash(herdr server stop*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Write(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/post-edit.sh",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
