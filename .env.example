# Copy to .env for local development. Never commit .env.
APP_PORT=8080
POSTGRES_USER=factorysim
POSTGRES_PASSWORD=change-me
POSTGRES_DB=factorysim
DATABASE_URL=postgres://factorysim:change-me@postgres:5432/factorysim
SESSION_SECRET=change-me-to-a-long-random-string
# Sign-in sessions end after this many idle hours, and after this many days regardless.
SESSION_IDLE_HOURS=8
SESSION_MAX_DAYS=7
# Set to true when a TLS-terminating proxy serves the app over HTTPS (adds Secure to the cookie).
COOKIE_SECURE=false
# Comma-separated IPs/CIDRs of the reverse proxy allowed to set X-Forwarded-For (e.g. 172.18.0.1).
# Empty trusts nobody. Never list addresses clients can reach the app from directly.
TRUST_PROXY=
