{
  "project": "docs/reference-model/model.json",
  "shots": [
    {
      "name": "reference-mid-run",
      "screen": "simulate",
      "themes": ["dark", "light"],
      "settle": 800,
      "actions": [
        {
          "eval": "(() => { const c = document.querySelector('canvas'); for (let i=0;i<6;i++) c.dispatchEvent(new WheelEvent('wheel', { deltaY: -120, clientX: 640, clientY: 400, bubbles: true, cancelable: true })); })()"
        },
        {
          "fill": ["input[type=range]", "60"]
        },
        {
          "click": "role=button[name=\"Play\"]"
        },
        {
          "wait": 14000
        },
        {
          "click": "role=button[name=\"Pause\"]"
        },
        {
          "wait": 600
        }
      ]
    }
  ]
}
